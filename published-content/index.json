{"articles":[{"id":"post-2a02d6a9-4b46-43ed-a8f0-2e663bcc51cc","title":"王牌VPN测评站开启公测，机场免费申请收录","category":"站点公告","summary":"公测期间，各类机场均可免费申请收录。机场主可通过「申请入驻」提交资料，审核通过后展示在机场目录。","date":"2026-11-10","readMinutes":1,"tags":[],"theme":"amber","illustration":"document","sections":[{"heading":"正文","paragraphs":["王牌VPN测评站现已开放公测。欢迎各类机场服务商提交站点资料，公测期间申请与目录收录均免费。","机场主可在首页点击「申请入驻」，按表单提示填写机场名称、官网、线路、节点地区、套餐和联系方式。提交成功后，请保留页面生成的提交凭证，方便核对。","资料审核通过后会收录到机场目录。测评报告和评分会在完成相应测试后展示，未完成的项目会标为待测。联系方式和测试账号仅用于审核与测评。"]}]}],"reports":[{"id":"flybit","airportId":"flybit","airportName":"FlyBit","measuredAt":"2026-11-11T16:26:01.691Z","updatedAt":"2026-11-11T16:39:46.164Z","path":"#review/flybit","sampleScore":{"attemptedNodes":65,"plannedNodes":65,"completedNodes":53,"latencySamples":63,"downloadSamples":54,"value":2.5,"downloadScore":0.03818076923076923,"latencyScore":0.03150706436420723,"completionScore":8.153846153846153,"unavailableReason":null}}],"rankings":[{"key":"new","title":"新起之秀","enabled":true,"order":[]},{"key":"overall","title":"冠名赞助","enabled":true,"order":["flybit","99ba"],"links":{}},{"key":"stable","title":"老牌稳定","enabled":true,"order":[]}]}
